# Postgres. On Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://i2w2i:devpass@localhost:5432/i2w2i
# Optional: separate owner connection for migrations (defaults to DATABASE_URL).
# DATABASE_URL_OWNER=

# The web server connects as the restricted role i2w2i_app with this
# password (24+ letters/digits/-/_). Required in production.
APP_DB_PASSWORD=

# 32+ random characters. Protects event codes and QR links. Required in
# production; changing it invalidates every printed QR card.
APP_SECRET=

# Storage. On Railway, reference the bucket's variables (docs/RAILWAY.md).
# Leave unset locally to use a folder (LOCAL_STORAGE_DIR, default /tmp/i2w2i-storage).
# AWS_S3_BUCKET_NAME=
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# Public origin, used in emailed links.
APP_URL=http://localhost:3000

# First admin (created/updated on every boot; idempotent).
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_NAME=Your Name
# Only used if the admin has no password yet. Remove after first deploy.
BOOTSTRAP_ADMIN_PASSWORD=
FAMILY_NAME=Our Family

# Email (Resend). Without a key, invite links are shown to the admin to send by hand.
RESEND_API_KEY=
EMAIL_FROM=i2w2i <hello@i2w2i.com>
